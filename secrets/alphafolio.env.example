# alphafolio_*.env — copy to `alphafolio.env` and fill before
# `docker compose up alphafolio_data alphafolio_quant alphafolio_portfolio`.
#
# Mounted via `env_file: ./secrets/alphafolio.env` in docker-compose.yaml.
# Do NOT commit the real file — only this `.example`.

# --- shared ---
# Used as the X-API-KEY header between data → quant → portfolio.
API_SECRET_KEY=change-me-to-a-random-string

# --- alphafolio_data: external data providers ---
ALPHAVANTAGE_API_KEY=
DART_API_KEY=
BOK_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
KRX_ID=
KRX_PW=
# Path inside container if you need GCS auth (mount the JSON as a volume too).
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-sa.json

# --- alphafolio_quant ---
# Optional — only used if quant calls OpenAI for any analysis.
OPENAI_API_KEY=

# --- alphafolio_portfolio: rebalancing agent (LLM + news search) ---
# OPENAI_API_KEY=     # reuses the one above
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
